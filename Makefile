CC ?= gcc
CFLAGS_BENCH ?= -std=gnu99 -O3
LFLAGS_BENCH ?= -lpng $(LDFLAGS)
CFLAGS_CONV ?= -std=c99 -O3
LFLAGS_CONV ?= $(LDFLAGS)
CFLAGS_TEST ?= -std=c99 -O2 -Wall -Wextra

TARGET_BENCH ?= qoibench
TARGET_CONV ?= qoiconv
TARGET_TEST ?= qoitest

all: $(TARGET_BENCH) $(TARGET_CONV)

bench: $(TARGET_BENCH)
$(TARGET_BENCH):$(TARGET_BENCH).c qoi.h
	$(CC) $(CFLAGS_BENCH) $(CFLAGS) $(TARGET_BENCH).c -o $(TARGET_BENCH) $(LFLAGS_BENCH)

conv: $(TARGET_CONV)
$(TARGET_CONV):$(TARGET_CONV).c qoi.h
	$(CC) $(CFLAGS_CONV) $(CFLAGS) $(TARGET_CONV).c -o $(TARGET_CONV) $(LFLAGS_CONV)

test: $(TARGET_TEST)
	./$(TARGET_TEST)
$(TARGET_TEST):$(TARGET_TEST).c qoi.h
	$(CC) $(CFLAGS_TEST) $(CFLAGS) $(TARGET_TEST).c -o $(TARGET_TEST) $(LFLAGS_CONV)

.PHONY: all bench conv test clean
clean:
	$(RM) $(TARGET_BENCH) $(TARGET_CONV) $(TARGET_TEST)
